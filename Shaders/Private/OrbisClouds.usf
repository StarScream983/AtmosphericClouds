#include "/Engine/Public/Platform.ush"
#include "/Engine/Private/Common.ush"
#include "/Engine/Private/InstancedStereo.ush"
#include "/Plugin/OrbisClouds/Noise.ush"
#include "/Plugin/OrbisClouds/OrbisClouds.ush"

float3 PlanetCenterRelative;
float InnerRadius;
float OuterRadius;
float CloudDensity;
float CloudCoverageNoiseScale;
uint NoiseSeed;
uint BaseNoiseType;
float NoiseOutputMin;
float NoiseOutputMax;
int CloudsCoverageOctaves;
float CloudsCoverageLacunarity;
float CloudsCoverageGain;
uint bCloudsCoverageUseWarp;
float CloudsCoverageWarpStrength;
int CloudsCoverageWarpOctaves;
float CloudTypeNoiseScale;
uint CloudTypeNoiseSeed;
uint CloudTypeNoiseType;
int CloudsTypeOctaves;
float CloudsTypeLacunarity;
float CloudsTypeGain;
uint CloudsViewMode;
uint bDebugSolid;
uint bDepthOcclusion;

Texture2D SceneDepthTexture;
SamplerState SceneDepthSampler;

void MainPS(
	in noperspective float4 UVAndScreenPos : TEXCOORD0,
	out float4 OutColor : SV_Target0)
{
	if (bDebugSolid != 0u)
	{
		OutColor = float4(1.0, 0.0, 1.0, 1.0);
		return;
	}

	const float2 UV = UVAndScreenPos.xy;
	const float2 ScreenPos = UVAndScreenPos.zw;
	const float3 RayOrigin = float3(0.0, 0.0, 0.0);
	const float3 RayDirection = ReconstructWorldRayDirection(ScreenPos);

	float tEnter = 0.0;
	float tExit = 0.0;
	if (!IntersectAtmosphereShell(RayOrigin, RayDirection, PlanetCenterRelative, InnerRadius, OuterRadius, tEnter, tExit))
	{
		discard;
	}

	if (bDepthOcclusion != 0u)
	{
		const float SceneViewDepth = ConvertFromDeviceZ(Texture2DSampleLevel(SceneDepthTexture, SceneDepthSampler, UV, 0).r);
		const float SceneRayDistance = SceneDepthToRayDistance(SceneViewDepth, RayDirection);
		ClipShellBySceneDepth(tEnter, tExit, SceneRayDistance);

		if (tExit <= tEnter)
		{
			discard;
		}
	}

	// Project the shell entry onto the inner sphere so coverage is constant through the layer.
	const float3 ShellEntryPosition = RayOrigin + RayDirection * tEnter;
	const float3 DirectionFromPlanetCenter = normalize(ShellEntryPosition - PlanetCenterRelative);
	const float3 InnerSurfacePosition = DirectionFromPlanetCenter * InnerRadius;

	const float2 WeatherMap = CalculateWeatherMap(
		InnerSurfacePosition,
		InnerRadius,
		CloudCoverageNoiseScale,
		BaseNoiseType,
		NoiseSeed,
		NoiseOutputMin,
		NoiseOutputMax,
		CloudsCoverageOctaves,
		CloudsCoverageLacunarity,
		CloudsCoverageGain,
		bCloudsCoverageUseWarp != 0u,
		CloudsCoverageWarpStrength,
		CloudsCoverageWarpOctaves,
		CloudTypeNoiseScale,
		CloudTypeNoiseType,
		CloudTypeNoiseSeed,
		CloudsTypeOctaves,
		CloudsTypeLacunarity,
		CloudsTypeGain);

	float Color = 0.;
	switch (CloudsViewMode)
	{
	case 0u:
		Color = WeatherMap.x;
		break;
	case 1u:
		Color = WeatherMap.y;
		break;
	case 2u:
	{
		// TEMPORARY RAYMARCH CODE------------------------------------------------------------------------
		const float SegmentLength = tExit - tEnter;
		if (SegmentLength <= 0.0)
		{
			OutColor = float4(0., 0., 0., 1.0);
			return;
		}

		const int StepCount = FindStepCount(RayDirection, PlanetCenterRelative);
		const float StepSize = SegmentLength / StepCount;
		const float ShellThickness = OuterRadius - InnerRadius;
		float OpticalDepth = 0.0;
		float WeightedHeight = 0.0;

		for (int StepIndex = 0; StepIndex < StepCount && ShellThickness > 0.0; StepIndex++)
		{
			const float t = tEnter + (StepIndex + 0.5) * StepSize;
			const float Radius = SampleRadiusAlongRay(t, RayDirection, PlanetCenterRelative);
			const float HeightFromBottom = (Radius - InnerRadius) / ShellThickness;
			if (HeightFromBottom < 0.0 || HeightFromBottom > 1.0)
			{
				continue;
			}

			const float3 StepPosition = RayOrigin + RayDirection * t;
			const float3 DirectionFromPlanetCenterAtStep = normalize(StepPosition - PlanetCenterRelative);
			const float3 SamplePosition = DirectionFromPlanetCenterAtStep * InnerRadius;

			const float2 Density = CalculateWeatherMap(
				SamplePosition,
				InnerRadius,
				CloudCoverageNoiseScale,
				BaseNoiseType,
				NoiseSeed,
				NoiseOutputMin,
				NoiseOutputMax,
				CloudsCoverageOctaves,
				CloudsCoverageLacunarity,
				CloudsCoverageGain,
				bCloudsCoverageUseWarp != 0u,
				CloudsCoverageWarpStrength,
				CloudsCoverageWarpOctaves,
				CloudTypeNoiseScale,
				CloudTypeNoiseType,
				CloudTypeNoiseSeed,
				CloudsTypeOctaves,
				CloudsTypeLacunarity,
				CloudsTypeGain);

			// OpticalDepth += StepSize * saturate(Density.x);
			const float StepContribution = StepSize * saturate(Density.x);
			OpticalDepth += StepContribution;
			WeightedHeight += StepContribution * HeightFromBottom;
		}
		// raymarch end -------------------------------------------------------------------------------
		const float AverageHeightFraction = OpticalDepth > 0.0 ? WeightedHeight / OpticalDepth : 0.0;
		Color = OpticalDepth > 0.0 ? lerp(0.1, 1.0, AverageHeightFraction) : 0.0;
	}
	break;
	}
	OutColor = float4(Color, Color, Color, 1.0);
}
