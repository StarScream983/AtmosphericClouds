#include "/Engine/Public/Platform.ush"
#include "/Engine/Private/Common.ush"
#include "/Engine/Private/InstancedStereo.ush"
#include "/Plugin/AtmosphericClouds/CloudScapesShell.ush"
#include "/Plugin/AtmosphericClouds/CloudScapesAtmo.ush"

float3 PlanetCenterRelative;
float PlanetSurfaceRadius;
float AtmoRadius;
uint bDebugSolid;
uint bDepthOcclusion;

float AtmoFalloff;
float AtmoSunIntensity;
float AtmoScatteringStrength;
float AtmoDensityModifier;
float AtmoCoeffMod;
float AtmoMinOpD;

Texture2D SceneDepthTexture;
SamplerState SceneDepthSampler;

void MainPS(
	in noperspective float4 UVAndScreenPos : TEXCOORD0,
	out float4 OutColor : SV_Target0)
{
	if (bDebugSolid != 0u)
	{
		OutColor = float4(1.0, 0.0, 1.0, 1.0);
		return;
	}

	const float2 UV = UVAndScreenPos.xy;
	const float2 ScreenPos = UVAndScreenPos.zw;
	const float3 RayOrigin = float3(0.0, 0.0, 0.0);
	const float3 RayDirection = ReconstructWorldRayDirection(ScreenPos);

	float AtmoTEnter = 0.0;
	float AtmoTExit = 0.0;
	if (!RaySphereIntersection(RayOrigin, RayDirection, PlanetCenterRelative, AtmoRadius, AtmoTEnter, AtmoTExit))
	{
		discard;
	}

	AtmoTEnter = max(AtmoTEnter, 0.0);

	float SceneRayDistance = AtmoTExit;
	if (bDepthOcclusion != 0u)
	{
		const float SceneViewDepth = ConvertFromDeviceZ(Texture2DSampleLevel(SceneDepthTexture, SceneDepthSampler, UV, 0).r);
		SceneRayDistance = SceneDepthToRayDistance(SceneViewDepth, RayDirection);

		if (SceneRayDistance <= AtmoTEnter)
		{
			discard;
		}

		AtmoTExit = min(AtmoTExit, SceneRayDistance);
	}

	if (AtmoTExit <= AtmoTEnter)
	{
		discard;
	}

	const float3 SunDir = CloudScapesGetSunDirection();
	const float MaxScatterDistance = AtmoTExit;
	const float4 AtmosphereColor = EvaluateCloudScapesAtmosphere(
		RayOrigin,
		RayDirection,
		PlanetCenterRelative,
		SunDir,
		PlanetSurfaceRadius,
		AtmoRadius,
		AtmoFalloff,
		AtmoSunIntensity,
		AtmoScatteringStrength,
		AtmoDensityModifier,
		SceneRayDistance,
		AtmoCoeffMod,
		AtmoMinOpD,
		MaxScatterDistance);

	if (AtmosphereColor.a <= 0.0)
	{
		discard;
	}

	OutColor = AtmosphereColor;
}
