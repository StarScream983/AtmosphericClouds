bool RaySphereIntersection(float3 RayOrigin, float3 RayDirection, float3 SphereCenter, float SphereRadius, out float t0, out float t1)
{
	float3 OriginToCenter = RayOrigin - SphereCenter;
	float B = dot(OriginToCenter, RayDirection);
	float C = dot(OriginToCenter, OriginToCenter) - SphereRadius * SphereRadius;
	float Discriminant = B * B - C;

	if (Discriminant < 0.0)
	{
		return false;
	}

	float SqrtDiscriminant = sqrt(Discriminant);
	t0 = -B - SqrtDiscriminant;
	t1 = -B + SqrtDiscriminant;
	return true;
}

// SceneViewDepth is linear depth along the camera forward axis (cm).
float SceneDepthToRayDistance(float SceneViewDepth, float3 RayDirection)
{
	return SceneViewDepth / max(dot(RayDirection, PrimaryView.ViewForward), 1e-5);
}

void ClipShellBySceneDepth(inout float tEnter, inout float tExit, float SceneRayDistance)
{
	if (SceneRayDistance <= tEnter)
	{
		tExit = tEnter;
		return;
	}

	tExit = min(tExit, SceneRayDistance);
}

bool IntersectAtmosphereShell(
	float3 RayOrigin,
	float3 RayDirection,
	float3 PlanetCenter,
	float InnerRadius,
	float OuterRadius,
	out float tEnter,
	out float tExit)
{
	float OuterT0 = 0.0;
	float OuterT1 = 0.0;
	if (!RaySphereIntersection(RayOrigin, RayDirection, PlanetCenter, OuterRadius, OuterT0, OuterT1))
	{
		return false;
	}

	tEnter = max(OuterT0, 0.0);
	tExit = OuterT1;

	if (tExit <= tEnter)
	{
		return false;
	}

	float InnerT0 = 0.0;
	float InnerT1 = 0.0;
	if (RaySphereIntersection(RayOrigin, RayDirection, PlanetCenter, InnerRadius, InnerT0, InnerT1))
	{
		if (InnerT0 > tEnter && InnerT0 < tExit)
		{
			tExit = InnerT0;
		}

		if (InnerT1 > tEnter && InnerT1 < tExit)
		{
			tEnter = InnerT1;
		}
	}

	return tExit > tEnter;
}

float3 ReconstructWorldRayDirection(float2 ScreenPos)
{
	return normalize(mul(float3(ScreenPos, 1), DFToFloat3x3(PrimaryView.ScreenToWorld)).xyz);
}
